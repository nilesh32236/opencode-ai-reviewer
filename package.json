{
  "name": "opencode-ai-reviewer",
  "version": "1.6.29",
  "description": "AI-powered PR review, auto-fix, and codebase audit — as a reusable GitHub Action & GitHub App",
  "private": false,
  "license": "MIT",
  "author": "nilesh32236",
  "repository": {
    "type": "git",
    "url": "https://github.com/nilesh32236/opencode-ai-reviewer"
  },
  "packageManager": "pnpm@10.8.0",
  "scripts": {
    "build": "pnpm --recursive build",
    "test": "pnpm --recursive test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "doc:check": "eslint '**/src/**/*.ts'",
    "doc:fix": "eslint '**/src/**/*.ts' --fix",
    "bench": "pnpm --filter @opencode-pr-agent/lib bench",
    "bench:check": "pnpm --filter @opencode-pr-agent/lib bench:check",
    "typecheck": "pnpm --recursive typecheck",
    "setup:local": "docker compose -f docker/docker-compose.yml $(if [ -f .env ]; then echo '--env-file .env'; fi) up -d --build",
    "teardown:local": "docker compose -f docker/docker-compose.yml $(if [ -f .env ]; then echo '--env-file .env'; fi) down"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.7.0",
    "eslint-plugin-jsdoc": "^63.2.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.2",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
