{
  "name": "@opencode-pr-agent/platform",
  "version": "1.11.5",
  "description": "Self-hosted web platform for OpenCode AI reviews — async task queue, webhook receiver, dashboard",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run copy:migrations",
    "copy:migrations": "node -e \"require('fs').cpSync('src/db/migrations', 'dist/db/migrations', { recursive: true })\"",
    "start": "node ./dist/index.js",
    "dev": "tsc --watch --preserveWatchOutput --incremental & node --watch ./dist/index.js",
    "dev:build": "tsc && node ./dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@opencode-pr-agent/lib": "workspace:*",
    "express": "5.2.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "5",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "6",
    "supertest": "7",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10"
  }
}
