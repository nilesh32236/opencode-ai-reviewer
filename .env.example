# =========================================================================
# OpenCode AI Reviewer — Local Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# =========================================================================

# -------------------------------------------------------------------------
# 1. GitHub Integration & Authentication
# -------------------------------------------------------------------------

# GitHub Personal Access Token (PAT) or installation token. Required.
GITHUB_TOKEN=your_github_token_here

# For GitHub App (Probot) Setup (Only needed if running the App)
# App ID from developer settings
APP_ID=
# Absolute path to your app's private key file (.pem) — do NOT paste the key inline
PRIVATE_KEY_PATH=
# Webhook secret to verify payloads
WEBHOOK_SECRET=

# -------------------------------------------------------------------------
# 2. AI Model Provider Keys
# -------------------------------------------------------------------------

# (Optional) OpenCode uses these keys if configuring models from other providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENCODE_API_KEY=

# -------------------------------------------------------------------------
# 2b. Custom LLM Model Hosting (self-hosted / enterprise providers)
# -------------------------------------------------------------------------
# OpenCode AI Reviewer supports custom, self-hosted, or enterprise LLM
# providers. Everything is also configurable (with full provider maps) via the
# `llm:` section in `.opencode-reviewer.yml`. Model selection happens through
# the model inputs (e.g. REVIEW_MODEL=ollama/llama3), and the environment
# variables below are forwarded to the OpenCode CLI as-is.

# Any OpenAI-compatible API (self-hosted gateway, vLLM, LM Studio, ...).
# Model id: "custom-openai/<model>" (e.g. REVIEW_MODEL=custom-openai/qwen3-coder).
# LLM_BASE_URL=https://llm.corp.example/v1
# LLM_API_KEY=your_internal_llm_key
# LLM_MODEL=qwen3-coder

# Ollama local models (defaults to the OpenAI-compatible endpoint at
# http://localhost:11434/v1). Model id: "ollama/<model>".
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3

# Azure OpenAI (deployment routing via the model id: REVIEW_MODEL=azure/<deployment-name>).
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://my-resource.openai.azure.com
# AZURE_RESOURCE_NAME=my-resource
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# AWS Bedrock (model id: REVIEW_MODEL=amazon-bedrock/<model-id>).
# Authentication uses the standard AWS SDK credential chain:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=us-east-1
# AWS_PROFILE=
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_WEB_IDENTITY_TOKEN_FILE=
# AWS_ROLE_ARN=

# -------------------------------------------------------------------------
# 3. Agent Configuration Overrides
# -------------------------------------------------------------------------

# Models to use (Defaults to opencode/deepseek-v4-flash-free)
REVIEW_MODEL=opencode/deepseek-v4-flash-free
FIX_MODEL=opencode/deepseek-v4-flash-free

# Max number of files to process per sub-agent prompt batch
BATCH_SIZE=3

# Max review-fix iterations before giving up
MAX_ITERATIONS=3

# Enable/disable Model Context Protocol (MCP) servers.
# SECURITY: any enabled MCP server receives GITHUB_TOKEN as an env var and is
# fetched from npm at runtime — only enable trusted MCP servers.
ENABLE_MCP=false

# Severity threshold at or above which the reviewer's check run fails
# (off | critical | important | minor, default: off — opt-in). Works with GitHub
# branch protection required status checks.
FAIL_ON_SEVERITY=off

# Optional Slack / Teams review-summary notifications. These env vars take
# precedence over any webhook URL placed in `.opencode-reviewer.yml` and are the
# recommended way to inject webhook secrets (the config file is PR-editable).
# Enable notifications via the `notifications.enabled: true` section in
# `.opencode-reviewer.yml`; only findings at or above `notifications.minSeverity`
# (default: critical) trigger a message.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXX
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/XXXX-XXXX-XXXX-XXXX

# -------------------------------------------------------------------------
# 4. Project Rules & Verification Settings
# -------------------------------------------------------------------------

# Path to the rules/conventions markdown document
CONVENTIONS_PATH=.agents/AGENTS.md

# Short description of your project context
PROJECT_DESCRIPTION="AI-powered PR review, auto-fix, and codebase audit system."

# Commands to run in the auto-fix loop for checking/compiling changes
# Comma-separated command strings.
TYPECHECK_COMMANDS="pnpm typecheck"
LINT_COMMANDS="pnpm lint"

# -------------------------------------------------------------------------
# 5. Local Server Settings
# -------------------------------------------------------------------------

# Probot App port (defaults to 3000)
PORT=3000

# Logging verbosity (info, debug, warn, error)
LOG_LEVEL=info

# -------------------------------------------------------------------------
# 6. Rate Limiting (Probot App only)
# -------------------------------------------------------------------------

# Master switch for rate limit enforcement.
# Set to false to disable all rate limiting (recommended for single-user /
# personal deployments).
RATE_LIMIT_ENABLED=true

# Max command-tier reviews per repository per hour (default: 10)
RATE_LIMIT_REVIEWS_PER_REPO_HOUR=10

# Max reviews (all tiers combined) per GitHub user per day (default: 50)
RATE_LIMIT_REVIEWS_PER_USER_DAY=50

# Minimum minutes between command-tier actions on the same PR (default: 2)
RATE_LIMIT_PR_COOLDOWN_MINUTES=2

# Minimum seconds between interactive replies on the same PR (default: 30)
RATE_LIMIT_CONVERSATION_COOLDOWN_SECONDS=30

# Max estimated tokens consumed per rolling day (default: 500000)
RATE_LIMIT_DAILY_TOKEN_BUDGET=500000

# Estimated tokens charged per command-tier action (default: 25000)
RATE_LIMIT_ESTIMATED_TOKENS_PER_COMMAND=25000

# Estimated tokens charged per interactive action (default: 5000)
RATE_LIMIT_ESTIMATED_TOKENS_PER_INTERACTIVE=5000

# GitHub usernames allowed to run /rate-limits and /rate-limits-reset (comma-separated)
RATE_LIMIT_ADMIN_USERS=

# How long rate-limit rows are retained before cleanup, in hours (default: 48)
RATE_LIMIT_RETENTION_HOURS=48
