# OpenCode Platform — environment configuration.
#
# Copy to `.env.platform` and fill in your credentials:
#   cp .env.platform.example .env.platform
#
# Then start the platform stack:
#   docker compose -f docker/docker-compose.platform.yml --env-file .env.platform up -d --build

# --- Server ---
# HTTP port the platform server listens on (default: 8080).
PORT=8080

# --- Data layer ---
# PostgreSQL connection URL. Defaults to the compose `postgres` service.
DATABASE_URL=postgres://platform:platform@postgres:5432/platform

# Redis connection URL for the BullMQ queue. Defaults to the compose `redis`
# service. Leave empty to run without a queue.
REDIS_URL=redis://redis:6379

# Base directory for cloned workspaces.
WORKSPACE_DIR=/data/workspaces

# --- Postgres container credentials (only used by compose; must match DATABASE_URL) ---
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_DB=platform

# --- GitHub ---
# GitHub webhook secret (X-Hub-Signature-256 verification).
WEBHOOK_SECRET=

# GitHub App credentials (installation-token auth). If APP_ID + PRIVATE_KEY_PATH
# are absent, GITHUB_TOKEN is used instead.
APP_ID=
PRIVATE_KEY_PATH=
GITHUB_TOKEN=

# --- Logging ---
LOG_LEVEL=info

# --- Dashboard authentication (GitHub OAuth) ---
# Create a GitHub OAuth App at https://github.com/settings/developers
# Set the callback URL to <PUBLIC_BASE_URL>/auth/callback
# When these are empty, the dashboard/API are served without authentication
# (intended to sit behind the Caddy reverse proxy until auth is configured).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Secret used to sign dashboard session JWTs (generate with: openssl rand -hex 32).
SESSION_SECRET=
# Public base URL of the platform (for OAuth callback, behind Caddy).
PUBLIC_BASE_URL=https://opencode-reviewer.duckdns.org/platform
