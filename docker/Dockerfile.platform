# OpenCode Platform — multi-stage build.
#
# Stage 1 (builder) compiles the `lib` + `platform` workspace packages; only the
# compiled output and production dependencies are copied into the slim runtime
# stage (stage 2). The image runs as a non-root user.
#
# Both stages pin the base image to an exact Node patch release + digest so
# builds are reproducible.
# Maintainer: verify tag↔digest before changing the pin with:
#   docker buildx imagetools inspect node:24.21.0-bookworm-slim

# Stage 1 — build-time toolchain & compiled artifacts
FROM node:24.21.0-bookworm-slim@sha256:5cbc7caba8c2c0f0bca675d1b61b9f2857e1cf1853c6164ee9dd409501a936e7 AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates git python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g pnpm@10.8.0

WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY lib/package.json ./lib/
COPY platform/package.json ./platform/
COPY platform/web/package.json ./platform/web/

RUN pnpm install --frozen-lockfile

COPY . .

# Build lib + platform (server) and the web dashboard.
RUN pnpm --filter @opencode-pr-agent/lib --filter @opencode-pr-agent/platform build \
    && pnpm --filter @opencode-pr-agent/platform-web build

# Stage 2 — slim runtime with compiled output and production deps only
FROM node:24.21.0-bookworm-slim@sha256:5cbc7caba8c2c0f0bca675d1b61b9f2857e1cf1853c6164ee9dd409501a936e7 AS runtime

ENV NODE_ENV=production

WORKDIR /app

# Install only production dependencies into a fresh, self-contained pnpm
# virtual store (workspace symlinks resolve to the copied dist below).
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY lib/package.json ./lib/
COPY platform/package.json ./platform/
COPY platform/web/package.json ./platform/web/

# Runtime keeps only `git` (used by platform/src/workspace/git.ts) and
# `ca-certificates`. curl is builder-only. pnpm is installed via corepack,
# used for the prod install, then removed: the container starts with plain
# `node`, so shipping a package manager only grows the attack surface.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
      git ca-certificates \
    && corepack enable \
    && COREPACK_HOME=/tmp/corepack corepack prepare pnpm@10.8.0 --activate \
    && COREPACK_HOME=/tmp/corepack pnpm install --frozen-lockfile --prod \
    && corepack disable \
    && rm -rf /tmp/corepack /var/lib/apt/lists/*

# Create the unprivileged user before copying artifacts so ownership is set
# at copy time instead of via a recursive `chown -R` that duplicates the whole
# /app payload into a new layer.
RUN useradd --create-home --uid 10001 platform \
    && install -d -o platform -g platform /data/workspaces

# Copy only the compiled JS + the migrations bundle + the built dashboard.
COPY --chown=platform:platform --from=builder /app/lib/dist ./lib/dist
COPY --chown=platform:platform --from=builder /app/platform/dist ./platform/dist
COPY --chown=platform:platform --from=builder /app/platform/web/dist ./platform/web/dist

USER platform

EXPOSE 8080

# Liveness probe against the always-200 /api/health route (the richer /health
# route returns 503 when a configured dependency is degraded, which should not
# restart an otherwise live server). Uses Node's global fetch — no curl.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||'8080')+'/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "./platform/dist/index.js"]
